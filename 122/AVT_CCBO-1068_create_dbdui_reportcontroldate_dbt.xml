<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="126_1_BIQ-29457_create_dbdui_reportcontroldate_dbt" author="borisov" context="prod">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="dbdui_reportcontroldate_dbt"/>
            </not>
        </preConditions>
        <createTable tableName="dbdui_reportcontroldate_dbt"
                     remarks="Справочник контрольных дат для отчётных форм">
            <column name="t_id" type="BIGINT" autoIncrement="true"
                    remarks="Идентификатор записи в справочнике">
                <constraints primaryKey="true" primaryKeyName="pk_reportcontroldate"/>
            </column>
            <column name="t_form" type="VARCHAR(50)"
                    remarks="Номер или строковый идентификатор отчётной формы"/>
            <column name="t_desc" type="VARCHAR(255)"
                    remarks="Описание периода предоставления отчётности"/>
            <column name="t_kind" type="NUMBER(2)"
                    remarks="Вид контрольной даты: 1 - рабочий день, 2 - календарный день">
                <constraints nullable="false"/>
            </column>
            <column name="t_interval" type="VARCHAR(20)"
                    remarks="Интервал предоставления отчётности в формате ISO 8601 (PnD, PnM)">
                <constraints nullable="false"/>
            </column>
            <column name="t_sincedate" type="DATE"
                    remarks="Дата начала действия записи справочника">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="126_1_BIQ-29457_load-dbdui_reportcontroldate_dbt" author="borisov" context="prod">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="dbdui_reportcontroldate_dbt"/>
        </preConditions>
        <loadData
                file="126_1_insert_dbdui_reportcontroldate_dbt.csv"
                tableName="dbdui_reportcontroldate_dbt"
                separator=","
                encoding="UTF-8"
                relativeToChangelogFile="true">
            <column name="t_form" type="STRING"/>
            <column name="t_kind" type="NUMBER(2)"/>
            <column name="t_interval" type="STRING"/>
            <column name="t_desc" type="STRING"/>
            <column name="t_sincedate" type="DATE"/>
        </loadData>
    </changeSet>

    <changeSet id="126_1_BIQ-29457_add_unique_constraint" author="borisov" context="prod">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="dbdui_reportcontroldate_dbt"/>
        </preConditions>
        <addUniqueConstraint
                constraintName="uk_reportcontroldate_form_since"
                tableName="dbdui_reportcontroldate_dbt"
                columnNames="t_form, t_sincedate"/>
    </changeSet>

    <changeSet id="126_1_BIQ-29457_add_fk_constraint" author="borisov" context="prod">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="dbdui_reportcontroldate_dbt"/>
                <tableExists tableName="dbdui_controldate_detail_dbt"/>
            </and>
        </preConditions>
        <addForeignKeyConstraint
                baseTableName="dbdui_reportcontroldate_dbt"
                baseColumnNames="t_form"
                constraintName="dbdui_reportcontroldate_dbt_fk"
                referencedTableName="dbdui_controldate_detail_dbt"
                referencedColumnNames="t_form" />
    </changeSet>

    <changeSet id="126_1_BIQ-29457_add_check_oracle" author="borisov" context="prod" dbms="oracle">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="dbdui_reportcontroldate_dbt"/>
        </preConditions>
        <sql>
            ALTER TABLE dbdui_reportcontroldate_dbt
            ADD CONSTRAINT dbdui_reportcontroldate_dbt_interval_chk
            CHECK (REGEXP_LIKE(t_interval, '^P[1-9][0-9]*[DM]$'))
        </sql>
    </changeSet>

    <changeSet id="126_1_BIQ-29457_add_check_postgresql" author="borisov" context="prod" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="dbdui_reportcontroldate_dbt"/>
        </preConditions>
        <sql>
            ALTER TABLE dbdui_reportcontroldate_dbt
            ADD CONSTRAINT dbdui_reportcontroldate_dbt_interval_chk
            CHECK (t_interval ~ '^P[1-9][0-9]*[DM]$')
        </sql>
    </changeSet>
</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="126_1_BIQ-29457_create_dbdui_reportpostinfo_dbt" author="borisov">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="dbdui_reportpostinfo_dbt"/>
            </not>
        </preConditions>
        <createTable tableName="dbdui_reportpostinfo_dbt"
                     remarks="Хранение информации о постфактумной отправке отчётности и квитанциях">
            <column name="t_form" type="VARCHAR(50)" remarks="Номер или строковый идентификатор отчётной формы">
                <constraints nullable="false"/>
            </column>
            <column name="t_limitdate" type="DATE" remarks="Контрольная дата отчётного периода">
                <constraints nullable="false"/>
            </column>
            <column name="t_sendday" type="DATE" remarks="Дата отправки отчётности"/>
            <column name="t_regdate" type="DATE" remarks="Дата регистрации отчётности в БР"/>
            <column name="t_status" type="VARCHAR(255)" remarks="Статус отправки/регистрации квитанции"/>
            <column name="t_message" type="CLOB" remarks="Сообщение об ошибке или предупреждении из квитанции"/>
            <column name="t_addtime" type="TIMESTAMP" defaultValueComputed="SYSTIMESTAMP"
                    remarks="Время добавления записи в систему">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="dbdui_reportpostinfo_dbt"
                baseColumnNames="t_form"
                constraintName="fk_reportpostinfo_form"
                referencedTableName="dbdui_controldate_detail_dbt"
                referencedColumnNames="t_form"/>
    </changeSet>
</databaseChangeLog>
